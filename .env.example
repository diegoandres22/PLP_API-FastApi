# Copiar a .env y completar. Nunca commitear el .env real.
#
# NOTA: esta API habla con Postgres DIRECTO (SQLAlchemy). No usa el SDK de
# Supabase, así que NO necesita SUPABASE_URL, ANON_KEY ni SERVICE_ROLE_KEY.
# Cambiar de proveedor de base de datos = cambiar solo DATABASE_URL.
# Detalles y solución de problemas en BASE_DE_DATOS.md.

# Cadena de conexión a Postgres. Sirve cualquier proveedor: Neon, Supabase,
# Render, RDS o un Postgres local.
#   Neon:     postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb
#   Supabase: postgresql://postgres:pass@db.xxxx.supabase.co:5432/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/patealaperola
# Si la contraseña lleva @ : / ? # o %, hay que codificarla en la URL.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Modo SSL de la conexión. 'require' en producción; 'disable' para un
# Postgres local o en Docker (antes estaba forzado a require en el código y
# hacía imposible levantar la API en local).
DB_SSLMODE=require

# Orígenes permitidos por CORS, separados por coma (sin espacios)
# Ej: https://patealaperola.com,https://admin.patealaperola.com
ALLOWED_ORIGINS=

# Debe ser EXACTAMENTE el mismo valor que API_JWT_SECRET en PLP-Admin.
# Generar con: openssl rand -base64 48
API_JWT_SECRET=

# SMTP para correos de confirmación/rechazo de compra
EMAIL_ADDRESS=
EMAIL_PASSWORD=

# Credenciales de la cuenta de servicio de Google Cloud Storage, en una
# sola línea de JSON (no la ruta a un archivo)
google_application_credentials_json=
